#!/usr/bin/env bash
# free-pi launcher.
#   1. locate an installed free-pi package
#   2. byte-restore the known-good chunk from ~/.free-pi/state/pinned
#   3. run the small maintenance pass
# The pinned copy is the source of truth, so a package update or a stray edit cannot change
# the running code: it is restored before every launch.
set -uo pipefail

for _n in "$HOME"/.nvm/versions/node/*/bin; do [ -d "$_n" ] && PATH="$_n:$PATH"; done
export PATH="$HOME/.local/bin:$PATH"
export FREEPI_NO_GRAVITY_PIXEL=1
export FREEPI_NO_AUTO_UPDATE=1
if ! command -v node >/dev/null 2>&1; then
	echo "free-pi: node not found (install Node >= 22.15)" >&2
	exit 127
fi

STATE="$HOME/.free-pi/state"

pkg_dir() {
	node <<'JS'
const path = require("node:path");
const home = process.env.HOME;
const pats = [
  path.join(home, ".npm/_npx/*/node_modules/free-pi-cli"),
  "$HOME/.nvm/versions/node/v22.23.4/lib/node_modules/free-pi-cli",
  path.join(home, ".nvm/versions/node/*/lib/node_modules/free-pi-cli"),
  (process.env.PREFIX || "") + "/lib/node_modules/free-pi-cli",
];
const expand = (p) => {
  if (!p.includes("*")) return [p];
  const [head, ...rest] = p.split("*");
  const tail = rest.join("*");
  let out = [];
  try { for (const e of fs.readdirSync(head.replace(/\/$/, ""))) out = out.concat(expand(head + e + tail)); } catch {}
  return out;
};
const cands = [];
for (const p of pats) for (const c of expand(p)) {
  try { if (require("node:fs").statSync(path.join(c, "dist")).isDirectory()) cands.push(c); } catch {}
}
const ver = (p) => { try { return require(path.join(p, "package.json")).version; } catch { return "0"; } };
if (!cands.length) process.exit(1);
const pref = cands.filter((c) => c.includes("usr/local"));
const list = pref.length ? pref : cands;
list.sort((a, b) => (ver(a) < ver(b) ? 1 : ver(a) > ver(b) ? -1 : 0));
console.log(list[0]);
JS
}

# Default model: deepseek-v4.1-flash. It is the free online model that keeps following the operator
# rules for offensive work; the "defense" (uncensored) models need premium credits, and the other
# free models (particle, deepseek-v4-flash, glm-5.3-flash) still refuse.
# A local bitllm gateway is only used when the caller asks for it explicitly
# (PI_LOCAL_DEFENSE=1 or PI_LOCAL_MODEL=<id>), because section=defense models cost credits online.
DEFMODEL="$HOME/.free-pi/agent/default-model.json"
if [ ! -f "$DEFMODEL" ]; then
	mkdir -p "$HOME/.free-pi/agent" 2>/dev/null
	printf '{"provider":"free-pi","model":"deepseek-v4.1-flash"}\n' >"$DEFMODEL" 2>/dev/null
fi
if [ "${PI_LOCAL_DEFENSE:-}" = "1" ] || [ -n "${PI_LOCAL_MODEL:-}" ]; then
	[ -f "$STATE/models-merge.cjs" ] && node "$STATE/models-merge.cjs" >/dev/null 2>&1 || true
fi

PKG="$(pkg_dir)" || true
if [ -z "${PKG:-}" ]; then
	npx --yes free-pi-cli@0.6.21 </dev/null >/dev/null 2>&1 || true
	PKG="$(pkg_dir)" || { echo "free-pi: no installed package found" >&2; exit 127; }
fi

if [ -f "$STATE/pinned/main-7sxf1v5b.js" ] && [ -d "$PKG/dist" ]; then
	cp -f "$STATE/pinned/main-7sxf1v5b.js" "$PKG/dist/main-7sxf1v5b.js" 2>/dev/null
fi

if ! grep -q 'main-qn3gsj3n.js.LICENSE.txt' "$PKG/dist/main-7sxf1v5b.js" 2>/dev/null; then
	PATCHER="$HOME/.free-pi/bin/bundle-patch.cjs"
	[ -f "$PATCHER" ] || PATCHER="$HOME/freepi-termux/dot-free-pi/bin/bundle-patch.cjs"
	[ -f "$PATCHER" ] && node "$PATCHER" "$PKG/dist/main-7sxf1v5b.js" >/dev/null 2>&1
	node "$HOME/.free-pi/bin/bundle-patch.cjs" >/dev/null 2>&1 || true
fi

[ -x "$STATE/maint.sh" ] && bash "$STATE/maint.sh" --quiet 2>/dev/null

exec node "$PKG/dist/index.js" "$@"
